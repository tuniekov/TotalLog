<?xml version="1.0" encoding="UTF-8"?>
<model package="totallog" baseClass="xPDOObject" platform="mysql" defaultEngine="InnoDB" phpdoc-package="totallog"
       version="1.1">
    <!--
        TLItem — маркер запроса. Одна строка на каждый обработанный MODX запрос.
        Пишется плагином TotalLog (OnMODXInit + register_shutdown_function).
        Доп. поля (excel_ids, smens) добавляются динамически через gtsAPI — см. _build/configs/data.js
    -->
    <object class="TLItem" table="totallog_items" extends="xPDOSimpleObject">
        <field key="modx_user_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
        <field key="username" dbtype="varchar" precision="100" phptype="string" null="false" default=""/>
        <field key="url" dbtype="varchar" precision="500" phptype="string" null="false" default=""/>
        <field key="method" dbtype="varchar" precision="10" phptype="string" null="false" default=""/>
        <field key="action" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
        <field key="component" dbtype="varchar" precision="100" phptype="string" null="false" default=""/>
        <!-- Таблица, которую дёрнули: для gtsAPI это часть URL (/api/TLItem), для legacy
             getTables — параметр table_name. ВНИМАНИЕ: не `table` — зарезервированное слово MySQL -->
        <field key="table_name" dbtype="varchar" precision="100" phptype="string" null="false" default=""/>
        <!-- ВНИМАНИЕ: поле называется description, а не desc — DESC зарезервированное слово MySQL -->
        <field key="description" dbtype="text" phptype="string" null="true"/>
        <field key="ip" dbtype="varchar" precision="45" phptype="string" null="false" default=""/>
        <!-- Страница, с которой пришёл запрос (HTTP_REFERER). Для XHR это адрес страницы,
             где нажали кнопку, — по нему видно, из какого интерфейса пришло действие -->
        <field key="referer" dbtype="varchar" precision="500" phptype="string" null="true" default=""/>
        <!-- Служебное действие (просмотры, options, статистика): пишем, но не показываем
             в пользовательском журнале. Список — в настройке totallog_service_actions -->
        <field key="service" dbtype="tinyint" precision="1" phptype="boolean" null="false" default="0"/>
        <!-- Исход запроса: 0 = сервер отказал (success:false в ответе API).
             Без этого журнал показывал бы намерение как свершившийся факт -->
        <field key="success" dbtype="tinyint" precision="1" phptype="boolean" null="false" default="1"/>
        <field key="request" dbtype="text" phptype="string" null="true"/>
        <field key="body" dbtype="mediumtext" phptype="string" null="true"/>

        <!-- Привязка к бинлогу MySQL: соединение + окно запроса -->
        <field key="thread_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
        <field key="created_at" dbtype="datetime" phptype="datetime" null="true"/>
        <field key="finished_at" dbtype="datetime" phptype="datetime" null="true"/>
        <field key="duration_ms" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
        <!-- Цена запроса в базе: сколько запросов и сколько на них ушло. Тяжёлые действия
             видно без профайлера — по журналу -->
        <field key="sql_count" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
        <field key="sql_time_ms" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>

        <index alias="modx_user_id" name="modx_user_id" primary="false" unique="false" type="BTREE">
            <column key="modx_user_id" length="" collation="A" null="false"/>
        </index>
        <index alias="action" name="action" primary="false" unique="false" type="BTREE">
            <column key="action" length="" collation="A" null="false"/>
        </index>
        <index alias="component" name="component" primary="false" unique="false" type="BTREE">
            <column key="component" length="" collation="A" null="false"/>
        </index>
        <index alias="created_at" name="created_at" primary="false" unique="false" type="BTREE">
            <column key="created_at" length="" collation="A" null="false"/>
        </index>
        <index alias="thread_id" name="thread_id" primary="false" unique="false" type="BTREE">
            <column key="thread_id" length="" collation="A" null="false"/>
        </index>
        <index alias="service" name="service" primary="false" unique="false" type="BTREE">
            <column key="service" length="" collation="A" null="false"/>
        </index>
        <index alias="table_name" name="table_name" primary="false" unique="false" type="BTREE">
            <column key="table_name" length="" collation="A" null="false"/>
        </index>

        <aggregate alias="User" class="modUser" local="modx_user_id" foreign="id" cardinality="one" owner="foreign"/>
    </object>
</model>
